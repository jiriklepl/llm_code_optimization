            if [[ "${4:-}" =~ ^[1-9]$ ]]; then
                REPETITION="0${4:-}"
            elif [[ "${4:-}" =~ ^[0-9][0-9]$ ]]; then
                REPETITION="${4:-}"
            else
                echo "Invalid repetition number: ${4:-}" >&2
                exit 1
            fi
        else
            REPETITION="01"
        fi

        ALGORITHM="${5:-all}"

        cd "${GPT_QUERYING_DIR}" || exit 1

        # C
        (
            echo "Processing C framework..." >&2
            for c_pair in "${C_PAIRS[@]}"; do
                IFS=' ' read -r -a paths <<< "${c_pair}"
                framework_path="${paths[0]}"
                generated_path="${paths[1]}"

                version_matched=false
                for version in "${VERSIONS_TO_RUN[@]}"; do
                    if [[ "${generated_path}" == *"${version}"* || "${framework_path}" == *"${version}"* ]]; then
                        version_matched=true
                        break
                    fi
                done

                if [[ " ${FRAMEWORKS_TO_RUN[*]} " =~ " c " ]] && [[ -d "${GPT_QUERYING_DIR}/${generated_path}" ]] && [ "${version_matched}" == true ]; then
                    if ! [ -d "${GPT_QUERYING_DIR}/${framework_path}" ]; then
                        echo "Directory ${GPT_QUERYING_DIR}/${framework_path} does not exist. Skipping." >&2
                        continue
                    fi

                    source_files=$(find "${GPT_QUERYING_DIR}/${framework_path}" -mindepth 3 -maxdepth 4 -name "*.c" -and ! -name "CMakeCXXCompilerId.cpp")

                    for file in $source_files; do
                        base_name="$(basename "${file}" .c)"

                        if [ "${ALGORITHM}" != "all" ] && [[ "${base_name}" != "${ALGORITHM}" ]]; then
                            continue
                        fi

                        generated_file="$(find "${GPT_QUERYING_DIR}/${generated_path}" -type d -name "${base_name}-${REPETITION}")"

                        if [ -z "${generated_file}" ]; then
                            continue
                        fi

                        generated_file="${generated_file}/code.cpp"

                        if [ -f "${generated_file}" ]; then
                            if [ "${DO_RUN}" == true ]; then
                                echo "Replacing ${file} with ${generated_file}" >&2
                                cp "${generated_file}" "${file}"
                            elif [ "${DIFF_RUN}" == true ]; then
                                echo "Diffing ${file} with ${generated_file}" >&2
                                diff -bu "${file}" "${generated_file}" || true
                            elif echo "Diffing ${file} with ${generated_file}" >&2 && ! diff -bu "${file}" "${generated_file}" >/dev/null; then
                                echo "cp \"${generated_file}\" \"${file}\""
                            fi
                        else
                            echo "Generated file ${generated_file} does not exist. Skipping." >&2
                        fi
                    done
                fi
            done
        )

        # Noarr
        (
            echo "Processing Noarr framework..." >&2
            for noarr_pair in "${NOARR_PAIRS[@]}"; do
                IFS=' ' read -r -a paths <<< "${noarr_pair}"
