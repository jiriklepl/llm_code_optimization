#!/bin/bash

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "This file should be sourced, not executed. Use 'source functions' or '. ./functions'" >&2
    exit 1
fi

GPT_QUERYING_DIR="$(realpath "$(dirname "${BASH_SOURCE[0]}")"/gpt-querying)"

NOARR_STRUCTURES_DIR="$(realpath "${GPT_QUERYING_DIR}/../submodules/noarr-structures")"
EXO_DIR="$(realpath "${GPT_QUERYING_DIR}/../submodules/exo")"

PATIENCE=8m

export GPT_QUERYING_DIR
export NOARR_STRUCTURES_DIR
export EXO_DIR

export PATIENCE
export GPT_QUERYING_PROVIDER="${GPT_QUERYING_PROVIDER:-${provider:-gpt51}}"

(
    cd "${GPT_QUERYING_DIR}" || exit 1

    # Ensure the virtual environment is created
    if [ ! -d ".venv" ]; then
        python3 -m venv .venv
    fi

    # If the virtual environment is not activated, activate it
    if [ -z "${VIRTUAL_ENV:-}" ]; then
        # shellcheck disable=SC1091
        source .venv/bin/activate
    fi

    # Upgrade pip and install required packages
    pip install --upgrade pip
    pip install -r requirements.txt
)

# shellcheck disable=SC1091
source "${GPT_QUERYING_DIR}/.venv/bin/activate"


resolve_provider() {
    if [ -n "${1:-}" ]; then
        printf '%s\n' "$1"
    else
        printf '%s\n' "${GPT_QUERYING_PROVIDER}"
    fi
}


request_file_for() {
    local provider="$1"
    local task="$2"
    local request_name="$3"

    printf '../requests/%s/%s/%s.jsonl\n' "$provider" "$task" "$request_name"
}


submit_batch_request() {
    local provider="$1"
    local request_file="$2"
    shift 2

    if [ -f "${request_file}" ]; then
        python run_batch.py --provider "${provider}" --request "${request_file}" "$@"
    else
        echo "Request file ${request_file} not found." >&2
    fi
}


reload() {
    # shellcheck disable=SC1091
    source "${GPT_QUERYING_DIR}/../functions"
}


unload() {
    unset -f generate
    unset -f print_cost_estimate
    unset -f cleanup
    unset -f translate
    unset -f optimize
    unset -f to_model
    unset -f from_model
    unset -f receive
    unset -f patch
    unset -f build
    unset -f replace_codes
    unset -f invalidate_codes
    unset -f postprocess_codes
    unset -f reload
    unset -f unload
    unset -f run
    unset -f check_translation
    unset -f check_optimization
    unset -f commands
    unset -f functions
    unset -f resolve_provider
    unset -f request_file_for
    unset -f submit_batch_request

    deactivate 2>/dev/null || true

    unset GPT_QUERYING_DIR
    unset NOARR_STRUCTURES_DIR
    unset EXO_DIR
    unset GPT_QUERYING_PROVIDER
}


generate() {
    (
        cd "${GPT_QUERYING_DIR}" || exit 1
        python main.py "$@"
    )
}


translate() {
    # translate [framework] [provider] [algorithm_category] [options]
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        case "${1:-}" in
          (c)
            FRAMEWORKS_TO_RUN=("c") ;;
          (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
          (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
          (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

          (all|"")
            FRAMEWORKS_TO_RUN=("c" "noarr" "halide" "exo") ;;

          (*)
            echo "Unsupported framework: ${1:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        PROVIDER="$(resolve_provider "${2:-}")"

        case "${3:-}" in
          (full|all|"")
            ALGORITHM_CATEGORY="full" ;;
          (full_part*)
            ALGORITHM_CATEGORY="full_part${3#full_part}" ;;
          (test)
            ALGORITHM_CATEGORY="test" ;;

          (datamining|dm|data-mining)
            ALGORITHM_CATEGORY="datamining" ;;
          (linear-algebra|la)
            ALGORITHM_CATEGORY="linear-algebra" ;;
          (stencil|stencils)
            ALGORITHM_CATEGORY="stencil" ;;
          (medley)
            ALGORITHM_CATEGORY="medley" ;;

          (*)
            echo "Unsupported algorithm category: ${3:-}" >&2
            return 1 ;;
        esac

        shift 3 || shift 2 || shift 1 || true

        for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
            submit_batch_request "${PROVIDER}" "$(request_file_for "${PROVIDER}" "translation" "${framework}_${ALGORITHM_CATEGORY}")" "$@"
        done
    )
}

