    echo "  print_cost_estimate       - Print the total cost estimate from generated files."
    echo "  cleanup [do|check|dry] [framework] [version] - Cleanup the generated code directories."
    echo "  translate [framework] [provider] [algorithm_category] [options] - Translate code to the specified framework using the language model."
    echo "  optimize [framework] [version] [provider] [algorithm_category] [options] - Optimize code for the specified framework and version using the language model."
    echo "  to_model [framework] [provider] [algorithm_category] [options] - Generate model specification for the specified framework using the language model."
    echo "  from_model [framework] [provider] [algorithm_category] [options] - Generate code from the model specification for the specified framework using the language model."
    echo "  receive [provider]         - Receive responses from the language model. For gemma this reports no pending work."
    echo "  patch                     - Apply patches to submodules."
    echo "  build [framework] [version] [options] - Build framework(s) (c, noarr, halide, exo, all; default: all) across version(s) (standard, naive, arithmetic, cache, structure, parallelism, all_hints, choose_hints, from_model, all; default: all)."
    echo "  replace_codes [mode] [framework] [version] [repetition] [algorithm] - Replace or diff generated code. Mode: do, check, dry (default: dry). Framework: c, noarr, halide, exo, all (default: all). Version list matches build (default: all). Repetition: integer (default: 1). Algorithm: name or all (default: all)."
    echo "  invalidate_codes [mode] [framework] [version] [algorithm] - Invalidate or diff generated code. Mode: do, check, dry (default: dry). Framework: c, noarr, halide, exo, all (default: all). Version list matches build (default: all). Algorithm: name or all (default: all)."
    echo "  postprocess_codes [framework] [version] - Run postprocessing scripts for the specified framework and version. Framework and version lists match build (default: all)."
    echo "  reload                    - Reload this functions script."
    echo "  unload                    - Unload this functions script and deactivate the virtual environment."
    echo "  run [algorithm] [framework] [version] - Execute algorithm(s) (name or all; default: all) on the selected frameworks/versions (same lists as build; defaults: frameworks=all, versions=all)."
    echo "  check_translation [algorithm] [framework] [absolute_tolerance] [relative_tolerance] - Compare stderr for translated frameworks versus the C baseline using floating tokens; reports status valid/validity_error/compile_error/runtime_error/timeout (tolerances default to CHECK_TRANSLATION_ABS_EPS, CHECK_TRANSLATION_REL_EPS; or 1e-6 and 0)."
    echo "  check_optimization [algorithm] [framework] [version] [absolute_tolerance] [relative_tolerance] - Compare stderr for optimized versions versus the standard baseline, reporting speedups when outputs match and status valid/validity_error/compile_error/runtime_error/timeout (defaults mirror run). Tolerances default to CHECK_OPTIMIZATION_ABS_EPS, CHECK_OPTIMIZATION_REL_EPS or 1e-6 and 0."
    echo "  commands                  - Show this help message."
    echo "  functions                 - Alias for commands."
}

