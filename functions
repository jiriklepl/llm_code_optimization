run() {
    # run <algorithm> <framework> <version> <repetitions>
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        case "${1:-}" in
        (all|"*"|"")
            ALGORITHMS_TO_RUN=("*") ;;
        (*)
            ALGORITHMS_TO_RUN=("${1:-}") ;;
        esac

        case "${2:-}" in
        (c)
            FRAMEWORKS_TO_RUN=("c") ;;
        (polly)
            FRAMEWORKS_TO_RUN=("polly") ;;
        (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
        (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
        (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

        (all|"")
            FRAMEWORKS_TO_RUN=("c" "polly" "noarr" "halide" "exo") ;;

        (*)
            echo "Unsupported framework: ${2:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        case "${3:-}" in
          (standard|translation)
            VERSIONS_TO_RUN=("standard") ;;
          (naive)
            VERSIONS_TO_RUN=("naive") ;;

          (arithmetic)
            VERSIONS_TO_RUN=("arithmetic") ;;
          (cache)
            VERSIONS_TO_RUN=("cache") ;;
          (structure)
            VERSIONS_TO_RUN=("structure") ;;
          (parallelism)
            VERSIONS_TO_RUN=("parallelism") ;;

          (all_hints)
            VERSIONS_TO_RUN=("all_hints") ;;
          (choose_hints)
            VERSIONS_TO_RUN=("choose_hints") ;;

          (from_model)
            VERSIONS_TO_RUN=("from_model") ;;

          (all|"")
            VERSIONS_TO_RUN=(
                "standard"
                "naive"

                "arithmetic"
                "cache"
                "structure"
                "parallelism"

                "all_hints"
                "choose_hints"

                "from_model"
            ) ;;

          (*)
            echo "Unsupported version: ${3:-}" >&2
            VERSIONS_TO_RUN=() ;;
        esac

        local repetitions="${4:-1}"
        if ! [[ "${repetitions}" =~ ^[1-9][0-9]*$ ]]; then
            echo "Repetitions must be a positive integer." >&2
            exit 1
        fi

        if [ "${#FRAMEWORKS_TO_RUN[@]}" -eq 0 ] || [ "${#VERSIONS_TO_RUN[@]}" -eq 0 ]; then
            exit 1
        fi

        declare -A FRAMEWORK_PATHS=(
            [c]="PolybenchC-4.2.1"
            [polly]="PolybenchC-Polly"
            [noarr]="PolybenchC-Noarr"
            [halide]="PolybenchC-Halide"
            [exo]="PolybenchC-Exo"
        )

        declare -A VERSION_PREFIXES=(
            [standard]="../"
            [naive]="../optimization/naive/"

            [arithmetic]="../optimization/arithmetic/"
            [cache]="../optimization/cache/"
            [structure]="../optimization/structure/"
            [parallelism]="../optimization/parallelism/"

            [all_hints]="../optimization/all_hints/"
            [choose_hints]="../optimization/choose_hints/"

            [from_model]="../from_model/"
        )

        for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
            base_path="${FRAMEWORK_PATHS[$framework]}"

            for version in "${VERSIONS_TO_RUN[@]}"; do
                prefix="${VERSION_PREFIXES[$version]}"
                if [ -z "${prefix}" ]; then
                    echo "No prefix configured for version ${version}. Skipping." >&2
                    continue
                fi

                dir="${prefix}${base_path}"

                if [ -d "${dir}" ]; then
                    echo "${framework} (${version}):" >&2
                    (
                        cd "${dir}" || exit 1

                        if [ ! -d build ]; then
                            echo "No build directory in ${dir}. Skipping." >&2
                            exit 0
                        fi

                        algorithms=$(find build -mindepth 1 -maxdepth 1 -type f -executable -printf "%f\n")

                        for algorithm in $algorithms; do
                            should_run=false
                            if [ "${ALGORITHMS_TO_RUN[0]}" = "*" ]; then
                                should_run=true
                            else
                                for allowed in "${ALGORITHMS_TO_RUN[@]}"; do
                                    if [ "${allowed}" = "${algorithm}" ]; then
                                        should_run=true
                                        break
                                    fi
                                done
                            fi

                            if [ "${should_run}" = true ]; then
                                for ((i=1; i<=repetitions; i++)); do
                                    local runtime_output=""
                                    runtime_output="$(timeout "${PATIENCE}" "./build/${algorithm}" 2>/dev/null | head -n 1)"
                                    local run_status=$?
                                    if [ "${run_status}" -eq 124 ]; then
                                        echo "${framework} (${version}) ${algorithm} timed out after ${PATIENCE} seconds." >&2
                                    elif [ "${run_status}" -ne 0 ]; then
                                        echo "${framework} (${version}) ${algorithm} failed during execution." >&2
                                    fi
                                    printf "%s,%s,%s,%d,%s\n" "${framework}" "${version}" "${algorithm}" "${i}" "${runtime_output}"
                                done
                            fi
                        done
                    )
                else
                    echo "Directory ${dir} does not exist. Skipping." >&2
                fi
            done
        done
    )
}


check_translation() {
    # check_translation <algorithm> <framework> [absolute_tolerance] [relative_tolerance]
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        local abs_epsilon_arg="${3:-}"
        local rel_epsilon_arg="${4:-}"
        local abs_epsilon
        local rel_epsilon

        if [ -n "${abs_epsilon_arg}" ]; then
            abs_epsilon="${abs_epsilon_arg}"
        else
            abs_epsilon="${CHECK_TRANSLATION_ABS_EPS:-1e-6}"
        fi

        if [ -n "${rel_epsilon_arg}" ]; then
            rel_epsilon="${rel_epsilon_arg}"
        else
            rel_epsilon="${CHECK_TRANSLATION_REL_EPS:-0}"
        fi

        if ! [[ "${abs_epsilon}" =~ ^([0-9]+([.][0-9]*)?|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
            echo "Absolute tolerance '${abs_epsilon}' is not a valid non-negative number." >&2
            exit 1
        fi

        if ! [[ "${rel_epsilon}" =~ ^([0-9]+([.][0-9]*)?|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
            echo "Relative tolerance '${rel_epsilon}' is not a valid non-negative number." >&2
            exit 1
        fi

        local -a ALGORITHMS_TO_RUN
        case "${1:-}" in
        (all|"*"|"")
            ALGORITHMS_TO_RUN=("*") ;;
        (*)
            ALGORITHMS_TO_RUN=("${1:-}") ;;
        esac

        local -a FRAMEWORKS_TO_RUN
        case "${2:-}" in
        (polly)
            FRAMEWORKS_TO_RUN=("polly") ;;
        (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
        (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
        (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

        (all|"")
            FRAMEWORKS_TO_RUN=("polly" "noarr" "halide" "exo") ;;

        (*)
            echo "Unsupported translation framework: ${2:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        if [ "${#FRAMEWORKS_TO_RUN[@]}" -eq 0 ]; then
            exit 1
        fi

        local baseline_dir="../PolybenchC-4.2.1"
        if [ ! -d "${baseline_dir}" ]; then
            echo "Baseline directory ${baseline_dir} does not exist." >&2
            exit 1
        fi

        if [ ! -d "${baseline_dir}/build" ]; then
            echo "Baseline build directory ${baseline_dir}/build is missing." >&2
            exit 1
        fi

        local -a BASELINE_ALGORITHMS=()
        if ! mapfile -t BASELINE_ALGORITHMS < <(cd "${baseline_dir}" && find build -mindepth 1 -maxdepth 1 -type f -executable -printf "%f\n" | sort); then
            echo "Unable to enumerate baseline algorithms." >&2
            exit 1
        fi

        if [ "${#BASELINE_ALGORITHMS[@]}" -eq 0 ]; then
            echo "No executable algorithms found in baseline ${baseline_dir}/build." >&2
            exit 1
        fi

        declare -A FRAMEWORK_PATHS=(
            [polly]="../PolybenchC-Polly"
            [noarr]="../PolybenchC-Noarr"
            [halide]="../PolybenchC-Halide"
            [exo]="../PolybenchC-Exo"
        )

        local overall_status=0

        emit_translation_result() {
            local framework="$1"
            local algorithm="$2"
            local runtime_value="$3"
            local speedup_value="$4"
            local status="$5"
            printf '%s,%s,%s,%s,%s\n' "${framework}" "${algorithm}" "${runtime_value}" "${speedup_value}" "${status}"
        }

        for algorithm in "${BASELINE_ALGORITHMS[@]}"; do
            local should_run=false
            if [ "${ALGORITHMS_TO_RUN[0]}" = "*" ]; then
                should_run=true
            else
                for allowed in "${ALGORITHMS_TO_RUN[@]}"; do
                    if [ "${allowed}" = "${algorithm}" ]; then
                        should_run=true
                        break
                    fi
                done
            fi

            if [ "${should_run}" != true ]; then
                continue
            fi

            local at_least_one=false
            for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
                local translation_dir="${FRAMEWORK_PATHS[$framework]}"
                if [ -d "${translation_dir}" ] && [ -d "${translation_dir}/build" ] && [ -x "${translation_dir}/build/${algorithm}" ]; then
                    at_least_one=true
                    break
                fi
            done

            if [ "${at_least_one}" = false ]; then
                echo "No translation frameworks available to run for algorithm ${algorithm}. Skipping." >&2
                for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
                    emit_translation_result "${framework}" "${algorithm}" "" "" "compile_error"
                done
                continue
            fi

            local baseline_tmp
            baseline_tmp="$(mktemp)"
            local baseline_stdout
            baseline_stdout="$(mktemp)"
            (
                cd "${baseline_dir}" || exit 1
                timeout "${PATIENCE}" "./build/${algorithm}" >"${baseline_stdout}" 2>"${baseline_tmp}"
            )
            local baseline_status=$?
            if [ "${baseline_status}" -ne 0 ]; then
                local baseline_failure_status="runtime_error"
                if [ "${baseline_status}" -eq 124 ]; then
                    echo "Baseline translation run for ${algorithm} timed out after ${PATIENCE} seconds." >&2
                    baseline_failure_status="timeout"
                else
                    echo "Failed to execute baseline for translation ${algorithm}." >&2
                fi
                for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
                    emit_translation_result "${framework}" "${algorithm}" "" "" "${baseline_failure_status}"
                done
                rm -f "${baseline_tmp}" "${baseline_stdout}"
                overall_status=1
                continue
            fi

            local baseline_time=""
            if ! baseline_time="$(python3 ../scripts/extract_runtime.py "${baseline_stdout}")"; then
                echo "Could not extract runtime from baseline stdout for translation ${algorithm}." >&2
                baseline_time=""
                overall_status=1
            fi

            for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
                local translation_dir="${FRAMEWORK_PATHS[$framework]}"
                local runtime_value=""
                local speedup_value=""
                local status="compile_error"
                local can_run=true
                local translated_tmp=""
                local translated_stdout=""
                local translated_time=""

                if [ -z "${translation_dir}" ]; then
                    echo "No directory configured for translation framework ${framework}." >&2
                    can_run=false
                    overall_status=1
                fi

                if [ "${can_run}" = true ] && [ ! -d "${translation_dir}" ]; then
                    echo "Translation directory ${translation_dir} does not exist for framework ${framework}." >&2
                    can_run=false
                    overall_status=1
                fi

                if [ "${can_run}" = true ] && [ ! -d "${translation_dir}/build" ]; then
                    echo "Build directory ${translation_dir}/build missing for framework ${framework}." >&2
                    can_run=false
                    overall_status=1
                fi

                if [ "${can_run}" = true ] && [ ! -x "${translation_dir}/build/${algorithm}" ]; then
                    echo "Executable ${translation_dir}/build/${algorithm} missing for framework ${framework}." >&2
                    can_run=false
                    overall_status=1
                fi

                if [ "${can_run}" = true ]; then
                    translated_tmp="$(mktemp)"
                    translated_stdout="$(mktemp)"
                    (
                        cd "${translation_dir}" || exit 1
                        timeout "${PATIENCE}" "./build/${algorithm}" >"${translated_stdout}" 2>"${translated_tmp}"
                    )
                    local translated_status=$?
                    case "${translated_status}" in
                        0)
                            status="valid"
                            ;;
                        124)
                            echo "Translation framework ${framework} for ${algorithm} timed out after ${PATIENCE} seconds." >&2
                            status="timeout"
                            can_run=false
                            overall_status=1
                            ;;
                        *)
                            echo "Failed to execute translation framework ${framework} for ${algorithm}." >&2
                            status="runtime_error"
                            can_run=false
                            overall_status=1
                            ;;
                    esac
                fi

                if [ "${can_run}" = true ]; then
                    if translated_time="$(python3 ../scripts/extract_runtime.py "${translated_stdout}")"; then
                        runtime_value="${translated_time}"
                    else
                        echo "Could not extract runtime from translation stdout for ${framework} ${algorithm}." >&2
                        translated_time=""
                        status="unknown_error"
                        can_run=false
                        overall_status=1
                    fi
                fi

                if [ "${can_run}" = true ]; then
                    if python3 ../scripts/compare_translation_stderr.py "${baseline_tmp}" "${translated_tmp}" "${abs_epsilon}" "${rel_epsilon}"; then
                        if [ -n "${baseline_time}" ] && [ -n "${translated_time}" ]; then
                            local speedup_output
                            if speedup_output="$(python3 ../scripts/compute_speedup.py "${baseline_time}" "${translated_time}")"; then
                                local formatted_baseline formatted_translated speedup
                                local old_ifs="${IFS}"
                                IFS=' '
                                read -r formatted_baseline formatted_translated speedup <<<"${speedup_output}"
                                IFS="${old_ifs}"
                                runtime_value="${formatted_translated}"
                                speedup_value="${speedup}"
                            else
                                status="speedup_error"
                                echo "Could not compute speedup for translation ${framework} ${algorithm} (baseline=${baseline_time}, translated=${translated_time})." >&2
                                overall_status=1
                            fi
                        fi
                    else
                        echo "Mismatch detected for translation ${framework} ${algorithm} (tolerance ${abs_epsilon} abs, ${rel_epsilon} rel)." >&2
                        status="validity_error"
                        overall_status=1
                    fi
                fi

                if [ -n "${translated_tmp}" ]; then
                    rm -f "${translated_tmp}" "${translated_stdout}"
                fi

                emit_translation_result "${framework}" "${algorithm}" "${runtime_value}" "${speedup_value}" "${status}"
            done

            rm -f "${baseline_tmp}" "${baseline_stdout}"
        done

        exit "${overall_status}"
    )
}


check_optimization() {
    # check_optimization <algorithm> <framework> <version> [absolute_tolerance] [relative_tolerance]
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        local abs_epsilon_arg="${4:-}"
        local rel_epsilon_arg="${5:-}"
        local abs_epsilon
        local rel_epsilon

        if [ -n "${abs_epsilon_arg}" ]; then
            abs_epsilon="${abs_epsilon_arg}"
        else
            abs_epsilon="${CHECK_OPTIMIZATION_ABS_EPS:-1e-6}"
        fi

        if [ -n "${rel_epsilon_arg}" ]; then
            rel_epsilon="${rel_epsilon_arg}"
        else
            rel_epsilon="${CHECK_OPTIMIZATION_REL_EPS:-0}"
        fi

        local -a ALGORITHMS_TO_RUN
        case "${1:-}" in
        (all|"*"|"")
            ALGORITHMS_TO_RUN=("*") ;;
        (*)
            ALGORITHMS_TO_RUN=("${1:-}") ;;
        esac

        local -a FRAMEWORKS_TO_RUN
        case "${2:-}" in
        (c)
            FRAMEWORKS_TO_RUN=("c") ;;
        (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
        (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
        (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

        (all|"")
            FRAMEWORKS_TO_RUN=("c" "noarr" "halide" "exo") ;;

        (*)
            echo "Unsupported framework: ${2:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        local -a VERSIONS_TO_RUN
        case "${3:-}" in
          (standard|translation)
            VERSIONS_TO_RUN=("standard") ;;
          (naive)
            VERSIONS_TO_RUN=("naive") ;;

          (arithmetic)
            VERSIONS_TO_RUN=("arithmetic") ;;
          (cache)
            VERSIONS_TO_RUN=("cache") ;;
          (structure)
            VERSIONS_TO_RUN=("structure") ;;
          (parallelism)
            VERSIONS_TO_RUN=("parallelism") ;;

          (all_hints)
            VERSIONS_TO_RUN=("all_hints") ;;
          (choose_hints)
            VERSIONS_TO_RUN=("choose_hints") ;;

          (from_model)
            VERSIONS_TO_RUN=("from_model") ;;

          (all|"")
            VERSIONS_TO_RUN=(
                "standard"
                "naive"

                "arithmetic"
                "cache"
                "structure"
                "parallelism"

                "all_hints"
                "choose_hints"

                "from_model"
            ) ;;

          (*)
            echo "Unsupported version: ${3:-}" >&2
            VERSIONS_TO_RUN=() ;;
        esac

        if [ "${#FRAMEWORKS_TO_RUN[@]}" -eq 0 ] || [ "${#VERSIONS_TO_RUN[@]}" -eq 0 ]; then
            exit 1
        fi

        declare -A FRAMEWORK_PATHS=(
            [c]="PolybenchC-4.2.1"
            [noarr]="PolybenchC-Noarr"
            [halide]="PolybenchC-Halide"
            [exo]="PolybenchC-Exo"
        )

        declare -A VERSION_PREFIXES=(
            [standard]="../"

            [naive]="../optimization/naive/"

            [arithmetic]="../optimization/arithmetic/"
            [cache]="../optimization/cache/"
            [structure]="../optimization/structure/"
            [parallelism]="../optimization/parallelism/"

            [all_hints]="../optimization/all_hints/"
            [choose_hints]="../optimization/choose_hints/"

            [from_model]="../from_model/"
        )

        local -a OPTIMIZED_VERSIONS=()
        declare -A seen_versions=()
        for version in "${VERSIONS_TO_RUN[@]}"; do
            if [ "${version}" = "standard" ]; then
                continue
            fi
            if [ -z "${seen_versions[$version]:-}" ]; then
                OPTIMIZED_VERSIONS+=("${version}")
                seen_versions[$version]=1
            fi
        done

        if [ "${#OPTIMIZED_VERSIONS[@]}" -eq 0 ]; then
            echo "No optimized versions selected for comparison; nothing to check." >&2
            exit 0
        fi

        if ! [[ "${abs_epsilon}" =~ ^([0-9]+([.][0-9]*)?|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
            echo "Tolerance '${abs_epsilon}' is not a valid non-negative number." >&2
            exit 1
        fi

        if ! [[ "${rel_epsilon}" =~ ^([0-9]+([.][0-9]*)?|\.[0-9]+)([eE][-+]?[0-9]+)?$ ]]; then
            echo "Relative tolerance '${rel_epsilon}' is not a valid non-negative number." >&2
            exit 1
        fi

        local overall_status=0

        emit_optimization_result() {
            local framework="$1"
            local version="$2"
            local algorithm="$3"
            local runtime_value="$4"
            local speedup_value="$5"
            local status="$6"
            printf '%s,%s,%s,%s,%s,%s\n' "${framework}" "${version}" "${algorithm}" "${runtime_value}" "${speedup_value}" "${status}"
        }

        for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
            local base_path="${FRAMEWORK_PATHS[$framework]}"
            if [ -z "${base_path}" ]; then
                echo "No base path configured for framework ${framework}. Skipping." >&2
                overall_status=1
                continue
            fi

            local baseline_dir="${VERSION_PREFIXES[standard]}${FRAMEWORK_PATHS[c]}"
            if [ -z "${baseline_dir}" ] || [ ! -d "${baseline_dir}" ]; then
                echo "Baseline directory ${baseline_dir} does not exist for framework ${framework}. Skipping." >&2
                overall_status=1
                continue
            fi

            if [ ! -d "${baseline_dir}/build" ]; then
                echo "Baseline build directory ${baseline_dir}/build is missing for framework ${framework}. Skipping." >&2
                overall_status=1
                continue
            fi

            local -a VALID_VERSIONS=()
            declare -A OPTIMIZED_DIRS=()
            for version in "${OPTIMIZED_VERSIONS[@]}"; do
                local prefix="${VERSION_PREFIXES[$version]}"
                if [ -z "${prefix}" ]; then
                    echo "No prefix configured for version ${version}. Skipping." >&2
                    overall_status=1
                    continue
                fi

                local candidate_dir="${prefix}${base_path}"
                if [ ! -d "${candidate_dir}" ]; then
                    echo "Directory ${candidate_dir} does not exist. Skipping version ${version} for framework ${framework}." >&2
                    continue
                fi

                if [ ! -d "${candidate_dir}/build" ]; then
                    echo "Build directory ${candidate_dir}/build missing. Skipping version ${version} for framework ${framework}." >&2
                    continue
                fi

                OPTIMIZED_DIRS["$version"]="${candidate_dir}"
                VALID_VERSIONS+=("${version}")
            done

            if [ "${#VALID_VERSIONS[@]}" -eq 0 ]; then
                echo "No optimized builds available for framework ${framework}. Skipping." >&2
                continue
            fi

            local -a BASELINE_ALGORITHMS=()
            if ! mapfile -t BASELINE_ALGORITHMS < <(cd "${baseline_dir}" && find build -mindepth 1 -maxdepth 1 -type f -executable -printf "%f\n" | sort); then
                echo "Unable to enumerate baseline algorithms for framework ${framework}. Skipping." >&2
                overall_status=1
                continue
            fi

            if [ "${#BASELINE_ALGORITHMS[@]}" -eq 0 ]; then
                echo "No executable algorithms found in baseline ${baseline_dir}/build. Skipping framework ${framework}." >&2
                overall_status=1
                continue
            fi

            for algorithm in "${BASELINE_ALGORITHMS[@]}"; do
                local should_run=false
                if [ "${ALGORITHMS_TO_RUN[0]}" = "*" ]; then
                    should_run=true
                else
                    for allowed in "${ALGORITHMS_TO_RUN[@]}"; do
                        if [ "${allowed}" = "${algorithm}" ]; then
                            should_run=true
                            break
                        fi
                    done
                fi

                if [ "${should_run}" != true ]; then
                    continue
                fi

                local at_least_one=false
                for version in "${VALID_VERSIONS[@]}"; do
                    local optimized_dir="${OPTIMIZED_DIRS[$version]}"
                    if [ -x "${optimized_dir}/build/${algorithm}" ]; then
                        at_least_one=true
                        break
                    fi
                done

                if [ "${at_least_one}" != true ]; then
                    echo "No optimized versions have executable for ${framework} ${algorithm}. Skipping." >&2
                    for version in "${VALID_VERSIONS[@]}"; do
                        emit_optimization_result "${framework}" "${version}" "${algorithm}" "" "" "compile_error"
                    done
                    overall_status=1
                    continue
                fi

                local baseline_tmp
                baseline_tmp="$(mktemp)"
                local baseline_stdout
                baseline_stdout="$(mktemp)"
                (
                    cd "${baseline_dir}" || exit 1
                    timeout "${PATIENCE}" "./build/${algorithm}" >"${baseline_stdout}" 2>"${baseline_tmp}"
                )
                local baseline_status=$?
                if [ "${baseline_status}" -ne 0 ]; then
                    local baseline_failure_status="runtime_error"
                    if [ "${baseline_status}" -eq 124 ]; then
                        echo "Baseline ${framework} standard run for ${algorithm} timed out after ${PATIENCE} seconds." >&2
                        baseline_failure_status="timeout"
                    else
                        echo "Failed to execute baseline for ${framework} standard ${algorithm}." >&2
                    fi
                    for version in "${VALID_VERSIONS[@]}"; do
                        emit_optimization_result "${framework}" "${version}" "${algorithm}" "" "" "${baseline_failure_status}"
                    done
                    rm -f "${baseline_tmp}" "${baseline_stdout}"
                    overall_status=1
                    continue
                fi

                local baseline_time
                if ! baseline_time="$(python3 ../scripts/extract_runtime.py "${baseline_stdout}")"; then
                    echo "Could not extract runtime from baseline stdout for ${framework} standard ${algorithm}." >&2
                    rm -f "${baseline_tmp}" "${baseline_stdout}"
                    overall_status=1
                    continue
                fi

                for version in "${VALID_VERSIONS[@]}"; do
                    local optimized_dir="${OPTIMIZED_DIRS[$version]}"
                    local runtime_value=""
                    local speedup_value=""
                    local status="compile_error"
                    local can_run=true
                    local optimized_tmp=""
                    local optimized_stdout=""
                    local optimized_time=""

                    if [ -z "${optimized_dir}" ]; then
                        echo "No directory recorded for version ${version} and framework ${framework}." >&2
                        can_run=false
                        overall_status=1
                    fi

                    if [ "${can_run}" = true ] && [ ! -x "${optimized_dir}/build/${algorithm}" ]; then
                        echo "Executable ${optimized_dir}/build/${algorithm} missing. Skipping comparison for version ${version}." >&2
                        can_run=false
                        overall_status=1
                    fi

                    if [ "${can_run}" = true ]; then
                        optimized_tmp="$(mktemp)"
                        optimized_stdout="$(mktemp)"
                        (
                            cd "${optimized_dir}" || exit 1
                            timeout "${PATIENCE}" "./build/${algorithm}" >"${optimized_stdout}" 2>"${optimized_tmp}"
                        )
                        local optimized_status=$?
                        case "${optimized_status}" in
                            0)
                                status="valid"
                                ;;
                            124)
                                echo "${framework} ${version} for ${algorithm} timed out after ${PATIENCE} seconds." >&2
                                status="timeout"
                                can_run=false
                                overall_status=1
                                ;;
                            *)
                                echo "Failed to execute optimized version ${version} for ${framework} ${algorithm}." >&2
                                status="runtime_error"
                                can_run=false
                                overall_status=1
                                ;;
                        esac
                    fi

                    if [ "${can_run}" = true ]; then
                        if optimized_time="$(python3 ../scripts/extract_runtime.py "${optimized_stdout}")"; then
                            runtime_value="${optimized_time}"
                        else
                            echo "Could not extract runtime from optimized stdout for ${framework} ${version} ${algorithm}." >&2
                            status="unknown_error"
                            can_run=false
                            overall_status=1
                        fi
                    fi

                    if [ "${can_run}" = true ]; then
                        if python3 ../scripts/compare_translation_stderr.py "${baseline_tmp}" "${optimized_tmp}" "${abs_epsilon}" "${rel_epsilon}"; then
                            if [ -n "${baseline_time}" ] && [ -n "${optimized_time}" ]; then
                                local speedup_output
                                if speedup_output="$(python3 ../scripts/compute_speedup.py "${baseline_time}" "${optimized_time}")"; then
                                    local formatted_baseline formatted_optimized speedup
                                    local old_ifs="${IFS}"
                                    IFS=' '
                                    read -r formatted_baseline formatted_optimized speedup <<<"${speedup_output}"
                                    IFS="${old_ifs}"
                                    runtime_value="${formatted_optimized}"
                                    speedup_value="${speedup}"
                                else
                                    status="speedup_error"
                                    echo "Could not compute speedup for ${framework} ${version} ${algorithm} (baseline=${baseline_time}, optimized=${optimized_time})." >&2
                                    overall_status=1
                                fi
                            fi
                        else
                            echo "Mismatch detected for ${framework} ${version} ${algorithm} (absolute tolerance ${abs_epsilon}, relative tolerance ${rel_epsilon})." >&2
                            status="validity_error"
                            overall_status=1
                        fi
                    fi

                    if [ -n "${optimized_tmp}" ]; then
                        rm -f "${optimized_tmp}" "${optimized_stdout}"
                    fi

                    emit_optimization_result "${framework}" "${version}" "${algorithm}" "${runtime_value}" "${speedup_value}" "${status}"
                done

                rm -f "${baseline_tmp}" "${baseline_stdout}"
            done
        done

        exit "${overall_status}"
    )
}


