    )
}


cleanup() {
    # cleanup [do|check|dry] [framework] [version]
    (
        if [ "${1:-}" == "do" ]; then
            DO_RUN=true
        elif [ "${1:-}" == "check" ]; then
            DO_RUN=false
            DIFF_RUN=true
        elif [ "${1:-}" == "dry" ] || [ -z "${1:-}" ]; then
            DO_RUN=false
            DIFF_RUN=true
            echo "Dry run mode: No files will be replaced." >&2
        else
            DO_RUN=false
            DIFF_RUN=false
            echo "Dry run mode: No files will be replaced." >&2
        fi

        case "${2:-}" in
          (c)
            FRAMEWORKS_TO_RUN=("c") ;;
          (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
          (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
          (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

          (all|"")
            FRAMEWORKS_TO_RUN=("c" "noarr" "halide" "exo") ;;

          (*)
            echo "Unsupported framework: ${2:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        case "${3:-}" in
          (standard|translation)
            VERSIONS_TO_RUN=("standard") ;;
          (naive)
            VERSIONS_TO_RUN=("naive") ;;

          (arithmetic)
            VERSIONS_TO_RUN=("arithmetic") ;;
          (cache)
            VERSIONS_TO_RUN=("cache") ;;
          (structure)
            VERSIONS_TO_RUN=("structure") ;;
          (parallelism)
            VERSIONS_TO_RUN=("parallelism") ;;

          (all_hints)
            VERSIONS_TO_RUN=("all_hints") ;;
          (choose_hints)
            VERSIONS_TO_RUN=("choose_hints") ;;

          (to_model)
            VERSIONS_TO_RUN=("to_model") ;;
          (from_model)
            VERSIONS_TO_RUN=("from_model") ;;

          (all|"")
            VERSIONS_TO_RUN=(
                "standard"
                "naive"

                "arithmetic"
                "cache"
                "structure"
                "parallelism"

                "all_hints"
                "choose_hints"

                "to_model"
                "from_model"
            ) ;;

          (*)
            echo "Unsupported version: ${3:-}" >&2
            VERSIONS_TO_RUN=() ;;
        esac

        cd "${GPT_QUERYING_DIR}" || exit 1

        declare -A VERSION_PREFIXES=(
            [standard]="../generated"
            [naive]="../optimization"

            [arithmetic]="../optimization"
            [cache]="../optimization"
            [structure]="../optimization"
            [parallelism]="../optimization"

            [all_hints]="../optimization"
            [choose_hints]="../optimization"

            [to_model]="../to_model"
            [from_model]="../from_model"
        )

        declare -A VERSION_SUFFIXES=(
            [standard]=""
            [naive]="_naive"

            [arithmetic]="_arithmetic"
            [cache]="_cache"
            [structure]="_structure"
            [parallelism]="_parallelism"

            [all_hints]="_all_hints"
            [choose_hints]="_choose_hints"

            [to_model]=""
            [from_model]="_from_model"
        )

        for version in "${VERSIONS_TO_RUN[@]}"; do
            for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
                prefix="${VERSION_PREFIXES[$version]}"
                suffix="${VERSION_SUFFIXES[$version]}"

                dir="${prefix}/${framework}${suffix}"

                if [ -d "${dir}" ]; then
                    if [ "${DO_RUN}" == true ]; then
                        echo "Cleaning directory: ${dir}" >&2
                        git clean -fdx -- "${dir}"
                    elif [ "${DIFF_RUN}" == true ]; then
                        echo "Checking cleanliness of directory: ${dir}" >&2
                        git clean -ndx -- "${dir}"
                    fi
                else
                    echo "Directory ${dir} does not exist. Skipping." >&2
                fi
            done
        done
    )
}


patch() {
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        for patch_file in ../patches/*.patch; do
            patch_file="$(realpath "${patch_file}")"

            if [ -f "${patch_file}" ]; then
                echo "Applying patch: ${patch_file}"
                base_name=$(basename "${patch_file}" .patch)

                if [ ! -d "../submodules/${base_name}" ]; then
                    echo "Directory ../submodules/${base_name} does not exist. Skipping." >&2
                    continue
                fi

                (
                    cd "../submodules/${base_name}" || exit 1
                    # restore to clean state before applying patch
                    git reset --hard HEAD
                    git clean -fdx
                    git apply "${patch_file}"
                )
            else
                echo "No patch files found in ../patches/. Skipping." >&2
            fi
        done
    )
}


build() {
    (
        cd "${GPT_QUERYING_DIR}" || exit 1

        case "${1:-}" in
          (c)
            FRAMEWORKS_TO_RUN=("c") ;;
          (polly)
            FRAMEWORKS_TO_RUN=("polly") ;;
          (noarr)
            FRAMEWORKS_TO_RUN=("noarr") ;;
          (halide)
            FRAMEWORKS_TO_RUN=("halide") ;;
          (exo)
            FRAMEWORKS_TO_RUN=("exo") ;;

          (all|"")
            FRAMEWORKS_TO_RUN=("c" "polly" "noarr" "halide" "exo") ;;

          (*)
            echo "Unsupported framework: ${1:-}" >&2
            FRAMEWORKS_TO_RUN=() ;;
        esac

        case "${2:-}" in
          (standard|translation)
            VERSIONS_TO_RUN=("standard") ;;
          (naive)
            VERSIONS_TO_RUN=("naive") ;;

          (arithmetic)
            VERSIONS_TO_RUN=("arithmetic") ;;
          (cache)
            VERSIONS_TO_RUN=("cache") ;;
          (structure)
            VERSIONS_TO_RUN=("structure") ;;
          (parallelism)
            VERSIONS_TO_RUN=("parallelism") ;;

          (all_hints)
            VERSIONS_TO_RUN=("all_hints") ;;
          (choose_hints)
            VERSIONS_TO_RUN=("choose_hints") ;;

          (from_model)
            VERSIONS_TO_RUN=("from_model") ;;

          (all|"")
            VERSIONS_TO_RUN=(
                "standard"
                "naive"

                "arithmetic"
                "cache"
                "structure"
                "parallelism"

                "all_hints"
                "choose_hints"

                "from_model"
            ) ;;
          (*)
            echo "Unsupported version: ${2:-}" >&2
            VERSIONS_TO_RUN=() ;;
        esac

        shift 2 || shift 1 || true

        if [ "${#FRAMEWORKS_TO_RUN[@]}" -eq 0 ] || [ "${#VERSIONS_TO_RUN[@]}" -eq 0 ]; then
            exit 1
        fi

        declare -A FRAMEWORK_PATHS=(
            [c]="PolybenchC-4.2.1"
            [polly]="PolybenchC-Polly"
            [noarr]="PolybenchC-Noarr"
            [halide]="PolybenchC-Halide"
            [exo]="PolybenchC-Exo"
        )

        declare -A VERSION_PREFIXES=(
            [standard]="../"
            [naive]="../optimization/naive/"

            [arithmetic]="../optimization/arithmetic/"
            [cache]="../optimization/cache/"
            [structure]="../optimization/structure/"
            [parallelism]="../optimization/parallelism/"

            [all_hints]="../optimization/all_hints/"
            [choose_hints]="../optimization/choose_hints/"

            [from_model]="../from_model/"
        )

        for framework in "${FRAMEWORKS_TO_RUN[@]}"; do
            base_path="${FRAMEWORK_PATHS[$framework]}"

            for version in "${VERSIONS_TO_RUN[@]}"; do
                prefix="${VERSION_PREFIXES[$version]}"
                if [ -z "${prefix}" ]; then
                    echo "No prefix configured for version ${version}. Skipping." >&2
                    continue
                fi

                dir="${prefix}${base_path}"

                if [ -d "${dir}" ]; then
                    (
                        cd "${dir}" || exit 1
                        if [ -f build.sh ]; then
                            ./build.sh "$@"
                        else
                            echo "No build.sh found in ${dir}. Skipping." >&2
                        fi
                    )
                else
                    echo "Directory ${dir} does not exist. Skipping." >&2
                fi
            done
        done
    )
}


