                    if ! [ -d "${GPT_QUERYING_DIR}/${framework_path}" ]; then
                        echo "Directory ${GPT_QUERYING_DIR}/${framework_path} does not exist. Skipping." >&2
                        continue
                    fi

                    source_files=$(find "${GPT_QUERYING_DIR}/${framework_path}" -mindepth 3 -maxdepth 4 -name "*.cpp" -and ! -name "CMakeCXXCompilerId.cpp")

                    for file in $source_files; do
                        base_name="$(basename "${file}" .cpp)"

                        if [ "${ALGORITHM}" != "all" ] && [[ "${base_name}" != "${ALGORITHM}" ]]; then
