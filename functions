                                diff -bu "${file}" "${generated_file}" || true
                            elif echo "Diffing ${file} with ${generated_file}" >&2 && ! diff -bu "${file}" "${generated_file}" >/dev/null; then
                                echo "cp \"${generated_file}\" \"${file}\""
                            fi
                        else
                            echo "Generated file ${generated_file} does not exist. Skipping." >&2
                        fi
                    done
