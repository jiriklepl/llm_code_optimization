# EditorConfig

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[*.sh]
indent_size = 4
indent_style = tab

[*.{hpp,h,cpp,c}]
indent_size = 4
indent_style = tab
